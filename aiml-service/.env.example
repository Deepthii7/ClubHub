# SQLite by default — swap for Postgres/MySQL in production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/clubhub_feedback
DATABASE_URL=sqlite:///./feedback.db

# Optional: enables the LLM layer (theme naming, executive summary,
# recommended actions). Without this, the service still fully works using
# the algorithmic fallback in app/llm/insights.py.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
